DATABASE_URL=sqlite:///./storage/docvault.db
STORAGE_PATH=./storage
SESSION_COOKIE_NAME=docvault_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=50
TESSERACT_CMD=tesseract
OCR_TIMEOUT_SECONDS=60
DOCUMENT_DELETE_USERNAME=dba
WEB_PORT=8080
# Solo producción (docker-compose.prod.yml): IP del servidor en la red local; Caddy publica 443 y 80 ahí.
DOCVAULT_HOST=192.168.1.50
